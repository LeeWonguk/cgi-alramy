# 이 파일을 .env 로 복사한 뒤 값을 채우세요.
#   cp .env.example .env && chmod 600 .env

# ── Slack ───────────────────────────────────────────────────────────────────
# 서버 기본 웹훅. 사용자가 웹의 '설정' 탭에서 자기 웹훅을 넣으면 그쪽이 우선입니다.
#
# Slack Incoming Webhook URL 발급:
#   1. https://api.slack.com/apps → Create New App → From scratch
#   2. Incoming Webhooks 활성화 → Add New Webhook to Workspace
#   3. 알림 받을 채널 선택 → 생성된 URL을 아래에 붙여넣기
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXXX/YYYY/ZZZZ

# ── Postgres ────────────────────────────────────────────────────────────────
# 사용자·감시 대상·관측 상태·알림 이력이 여기 쌓입니다.
# DB가 없으면 서버가 시작할 때 만듭니다.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/cgv

# ── 공개 주소 ───────────────────────────────────────────────────────────────
# OAuth 리다이렉트 URI를 이 값으로 만듭니다. 네이버·카카오 콘솔에 등록한 콜백과
# **문자열이 정확히 같아야** 합니다 (http/https, 포트, 끝 슬래시까지).
# 로컬에서 먼저 시험할 때는 http://localhost:8787 로 두고 콜백도 같게 등록하세요.
PUBLIC_BASE_URL=http://localhost:8787

# ── 소셜 로그인 ─────────────────────────────────────────────────────────────
# 네이버: https://developers.naver.com → 애플리케이션 등록 → 네이버 로그인 사용
#   Callback URL: {PUBLIC_BASE_URL}/api/auth/naver/callback
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 카카오: https://developers.kakao.com → 앱 → 카카오 로그인 활성화
#   Redirect URI: {PUBLIC_BASE_URL}/api/auth/kakao/callback
#   REST API 키를 쓰고, Client Secret은 콘솔에서 켠 경우에만 채우면 됩니다.
#   동의 항목에서 이메일은 선택으로 둬도 됩니다 — 없어도 로그인은 됩니다.
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# ── 세션 ────────────────────────────────────────────────────────────────────
# 비워 두면 서버가 만들어 DB에 보관합니다 (재시작해도 로그인이 유지됩니다).
# 직접 정하려면:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
FLASK_SECRET_KEY=
