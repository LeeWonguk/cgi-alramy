# 이 파일을 .env 로 복사한 뒤 값을 채우세요.
#   cp .env.example .env && chmod 600 .env

# ── 알림 웹훅 (Slack · Discord) ─────────────────────────────────────────────
# 서버 기본 웹훅. 사용자가 웹의 '설정' 탭에서 자기 웹훅을 넣으면 그쪽이 우선입니다.
# 종류는 주소를 보고 알아내므로 어느 칸에 넣어도 동작하고, 둘 다 채우면
# SLACK_WEBHOOK_URL이 먼저입니다. 자세한 절차는 웹의 '웹훅 설정법' 탭에 있습니다.
#
# Slack Incoming Webhook URL 발급:
#   1. https://api.slack.com/apps → Create New App → From scratch
#   2. Incoming Webhooks 활성화 → Add New Webhook to Workspace
#   3. 알림 받을 채널 선택 → 생성된 URL을 아래에 붙여넣기
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXXX/YYYY/ZZZZ

# Discord 웹후크 URL 발급:
#   1. 알림 받을 채널의 톱니바퀴(채널 편집) → 연동 → 웹후크
#   2. 새 웹후크 만들기 → 이름·채널 확인 → 변경 사항 저장
#   3. '웹후크 URL 복사'로 얻은 주소를 아래에 붙여넣기 (권한: 웹후크 관리)
DISCORD_WEBHOOK_URL=

# ── Postgres ────────────────────────────────────────────────────────────────
# 사용자·감시 대상·관측 상태·알림 이력이 여기 쌓입니다.
# DB가 없으면 서버가 시작할 때 만듭니다.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/cgv

# ── 공개 주소 ───────────────────────────────────────────────────────────────
# OAuth 리다이렉트 URI를 이 값으로 만듭니다. 네이버·카카오 콘솔에 등록한 콜백과
# **문자열이 정확히 같아야** 합니다 (http/https, 포트, 끝 슬래시까지).
# 로컬에서 먼저 시험할 때는 http://localhost:8787 로 두고 콜백도 같게 등록하세요.
PUBLIC_BASE_URL=http://localhost:8787

# ── 소셜 로그인 ─────────────────────────────────────────────────────────────
# 네이버: https://developers.naver.com → 애플리케이션 등록 → 네이버 로그인 사용
#   Callback URL: {PUBLIC_BASE_URL}/api/auth/naver/callback
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 카카오: https://developers.kakao.com → 앱 → 카카오 로그인 활성화
#   Redirect URI: {PUBLIC_BASE_URL}/api/auth/kakao/callback
#   REST API 키를 쓰고, Client Secret은 콘솔에서 켠 경우에만 채우면 됩니다.
#   동의 항목에서 이메일은 선택으로 둬도 됩니다 — 없어도 로그인은 됩니다.
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# ── 개발모드 로그인 ─────────────────────────────────────────────────────────
# 위 키가 하나도 없고 PUBLIC_BASE_URL이 localhost·127.0.0.1이면, 로그인 화면에
# '로컬 계정' 칸이 자동으로 열립니다. 이름만 적으면 그 이름의 계정으로 들어오고
# (비밀번호 없음) 첫 계정은 다른 로그인과 똑같이 소유자가 됩니다.
#   DEV_LOGIN=1  키가 있어도, 공개 주소여도 강제로 엽니다 (외부 공개 주소에서는
#                아무나 들어올 수 있으니 쓰지 마세요)
#   DEV_LOGIN=0  자동으로 열리는 것까지 막습니다
DEV_LOGIN=

# ── 세션 ────────────────────────────────────────────────────────────────────
# 비워 두면 서버가 만들어 DB에 보관합니다 (재시작해도 로그인이 유지됩니다).
# 직접 정하려면:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
FLASK_SECRET_KEY=

# ── 저장하는 CGV 로그인 비밀번호 암호화 키 ──────────────────────────────────
# 감시 대상 CGV 계정의 비밀번호를 되돌릴 수 있게 암호화해 DB에 보관합니다.
# 비워 두면 서버가 키를 만들어 DB에 넣지만(개발 편의), 그러면 키와 암호문이 같은
# DB에 있어 DB가 새면 보호가 되지 않습니다. 운영에서는 여기에 키를 직접 두세요.
# 만들기:  python3 -c "import secretbox; print(secretbox.generate_key())"
CGV_CRED_KEY=
